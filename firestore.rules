rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function hasValidUserFields(data) {
      return data.keys().hasAll(['nama', 'email', 'role', 'status'])
        && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.role is string && data.role in ['admin', 'manager', 'spv', 'hod', 'staff']
        && data.status is string && data.status in ['Approved', 'Pending'];
    }

    function hasValidDocumentFields(data) {
      return data.keys().hasAll(['title', 'category'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.category is string;
    }

    function hasValidLogFields(data) {
      return data.keys().hasAll(['timestamp', 'action'])
        && data.action is string && data.action.size() > 0 && data.action.size() <= 250;
    }

    // Portal user records
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && hasValidUserFields(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // Official intranet documents (SOPs, Forms, Announcements with Google Drive storage)
    match /documents/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && hasValidDocumentFields(request.resource.data);
      allow delete: if isValidId(docId);
    }

    // Structured Audit Access Logs
    match /accessLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && hasValidLogFields(request.resource.data);
      allow update, delete: if isValidId(logId);
    }

    // Category and subcategory master
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isValidId(catId);
    }

    // Department master records
    match /departments/{deptId} {
      allow read: if true;
      allow create, update, delete: if isValidId(deptId);
    }

    // KPI indicators master
    match /kpiMaster/{kpiId} {
      allow read: if true;
      allow create, update, delete: if isValidId(kpiId);
    }

    // Performance appraisals
    match /performances/{perfId} {
      allow read: if true;
      allow create, update, delete: if isValidId(perfId);
    }

    // In-app push notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notifId);
    }

    // Global system configuration
    match /systemConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isValidId(configId);
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
