{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile with role, department, and account status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "departemen": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "manager", "spv", "hod", "staff"] },
        "status": { "type": "string", "enum": ["Approved", "Pending"] },
        "password": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nama", "email", "role", "status"]
    },
    "document": {
      "title": "Intranet Document",
      "description": "SOP, Form, and Announcement records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "enum": ["SOP", "Form", "Pengumuman"] },
        "sub_kategori": { "type": "string" },
        "unit": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "akses_dept": { "type": "string" },
        "keterangan": { "type": "string" },
        "fileUrl": { "type": "string" },
        "previewUrl": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "thumbUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "uploadedByEmail": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category"]
    },
    "accessLog": {
      "title": "Access Log",
      "description": "Audit trail log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "role": { "type": "string" },
        "departemen": { "type": "string" },
        "actionCategory": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "timestamp", "action"]
    },
    "category": {
      "title": "Document Category",
      "description": "Document category per department",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama_kategori": { "type": "string" },
        "departemen": { "type": "string" }
      },
      "required": ["id", "nama_kategori"]
    },
    "department": {
      "title": "Department Master",
      "description": "Department code and name",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unit": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "hotelUnit": {
      "title": "Hotel Unit Master",
      "description": "Hotel Unit Group master entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "kpiMaster": {
      "title": "KPI Master",
      "description": "Standardized KPI indicators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "departemen": { "type": "string" },
        "tahun": { "type": "number" },
        "tipe": { "type": "string" },
        "pillar": { "type": "string" },
        "objective": { "type": "string" },
        "weight": { "type": "number" },
        "target": { "type": "string" }
      },
      "required": ["id", "departemen", "pillar", "objective"]
    },
    "performance": {
      "title": "Performance Appraisal",
      "description": "Employee performance evaluation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "nama": { "type": "string" },
        "departemen": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "email", "nama", "status"]
    },
    "notification": {
      "title": "Notification",
      "description": "System push notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "message"]
    },
    "systemConfig": {
      "title": "System Configuration",
      "description": "Branding, custom logo, and system parameters",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "subTitle": { "type": "string" },
        "customLogoUrl": { "type": "string" },
        "creatorSignature": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles and credentials"
    },
    "/documents/{documentId}": {
      "schema": "document",
      "description": "Official SOPs, Forms, and Announcements"
    },
    "/accessLogs/{logId}": {
      "schema": "accessLog",
      "description": "Audit access logs"
    },
    "/categories/{catId}": {
      "schema": "category",
      "description": "Category master records"
    },
    "/departments/{deptId}": {
      "schema": "department",
      "description": "Department master records"
    },
    "/kpiMaster/{kpiId}": {
      "schema": "kpiMaster",
      "description": "KPI targets master records"
    },
    "/performances/{perfId}": {
      "schema": "performance",
      "description": "Performance appraisal records"
    },
    "/notifications/{notifId}": {
      "schema": "notification",
      "description": "In-app push notifications"
    },
    "/systemConfig/{configId}": {
      "schema": "systemConfig",
      "description": "Global branding and system config"
    },
    "/hotelUnits/{unitId}": {
      "schema": "hotelUnit",
      "description": "Hotel Unit Group master records"
    }
  }
}
